{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["github-copilot"],
  "model": "github-copilot/claude-sonnet-4.6",
  "permission": {
    "external_directory": {
      "/Users/marc/git/digitec/**": "allow",
      "/Users/marc/git/private/**": "allow",
      "/Users/marc/dotfiles/**": "allow",
      "/Users/marc/.config/opencode/**": "allow"
    },
    "read": {
      "*": "allow",
      // Built-in .env guard
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      // Secret files
      "*secret*": "deny",
      "*secrets*": "deny",
      "*.tfvars": "deny",
      "*.tfvars.json": "deny",
      "*credentials*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    // Allowlist-first. Default = "ask". Two buckets:
    //   1) SAFE      — binaries with no dangerous subcommand/flag. Blanket allow.
    //   2) DANGEROUS — capable of mutate/deploy/exec/exfil. Only the explicit
    //                  safe subcommands are allowed; everything else falls to
    //                  the default "ask". No tool is blanket-allowed here.
    // Plus a small path-based secret-file block at the very end (cuts across
    // every reader, so it can't be expressed as a subcommand rule).
    "bash": {
      "*": "ask",

      // ============================ 1) SAFE ============================
      // No code-exec, no remote, no destructive subcommand.
      "ls*": "allow",
      "pwd": "allow",
      "cd*": "allow",
      "echo*": "allow",
      "cat*": "allow",
      "bat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "which*": "allow",
      "whoami": "allow",
      "id": "allow",
      "date*": "allow",
      "uname*": "allow",
      "hostname": "allow",
      "tree*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "du*": "allow",
      "df*": "allow",
      "basename*": "allow",
      "dirname*": "allow",
      "realpath*": "allow",
      "readlink*": "allow",
      "grep*": "allow",
      "cut*": "allow",
      "uniq*": "allow",
      "diff*": "allow",
      "jq*": "allow",
      "mkdir*": "allow",
      "touch*": "allow",
      "cp*": "allow",
      "mv*": "allow",
      "ln*": "allow",

      // ========================= 2) DANGEROUS =========================
      // Only the safe subcommands below run automatically.

      // --- git: local read + non-destructive only (push/fetch/clone/checkout/reset -> ask) ---
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git tag*": "allow",
      "git describe*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git blame*": "allow",
      "git ls-files*": "allow",
      "git shortlog*": "allow",
      "git reflog*": "allow",
      "git cat-file*": "allow",
      "git remote -v*": "allow",
      "git stash list*": "allow",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git config -l*": "allow",
      "git add*": "allow",
      "git commit*": "allow",

      // --- dotnet: build/validate (run/publish/nuget push/tool/ef -> ask) ---
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "dotnet restore*": "allow",
      "dotnet format*": "allow",
      "dotnet clean*": "allow",
      "dotnet list*": "allow",
      "dotnet sln*": "allow",
      "dotnet nuget locals*": "allow",
      "dotnet --version*": "allow",
      "dotnet --info*": "allow",
      "dotnet --list-sdks*": "allow",
      "dotnet --list-runtimes*": "allow",

      // --- node / js: build/test scripts (publish/exec/npx -> ask) ---
      "node --version*": "allow",
      "node -v*": "allow",
      "npm i*": "allow",
      "npm ci*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm build*": "allow",
      "npm list*": "allow",
      "npm ls*": "allow",
      "npm view*": "allow",
      "npm outdated*": "allow",
      "npm audit*": "allow",
      "npm --version*": "allow",
      "pnpm run*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm list*": "allow",
      "yarn run*": "allow",
      "yarn test*": "allow",
      "yarn build*": "allow",
      "bun run*": "allow",
      "bun test*": "allow",

      // --- python: validation/build (arbitrary scripts, -c, http.server -> ask) ---
      "python --version*": "allow",
      "python -V*": "allow",
      "python3 --version*": "allow",
      "python3 -V*": "allow",
      "python -m venv*": "allow",
      "python -m pytest*": "allow",
      "python -m py_compile*": "allow",
      "python3 -m venv*": "allow",
      "python3 -m pytest*": "allow",
      "pip list*": "allow",
      "pip show*": "allow",
      "pip freeze*": "allow",
      "pip check*": "allow",
      "pip3 list*": "allow",
      "pip3 show*": "allow",
      "pip3 freeze*": "allow",

      // --- go / cargo / make: build & test (run/publish -> ask) ---
      "go build*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "go fmt*": "allow",
      "gofmt*": "allow",
      "go list*": "allow",
      "go mod*": "allow",
      "go env*": "allow",
      "go doc*": "allow",
      "go version*": "allow",
      "cargo build*": "allow",
      "cargo check*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "cargo tree*": "allow",
      "cargo doc*": "allow",
      "cargo --version*": "allow",
      "make*": "allow",

      // --- terraform / opentofu: validate/plan/read (apply/destroy/import/state-mutate -> ask) ---
      "terraform validate*": "allow",
      "terraform fmt*": "allow",
      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform output*": "allow",
      "terraform state list*": "allow",
      "terraform state show*": "allow",
      "terraform providers*": "allow",
      "terraform version*": "allow",
      "terraform graph*": "allow",
      "terraform workspace list*": "allow",
      "terraform workspace show*": "allow",
      "terraform init*": "allow",
      "tofu validate*": "allow",
      "tofu fmt*": "allow",
      "tofu plan*": "allow",
      "tofu show*": "allow",
      "tofu output*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu providers*": "allow",
      "tofu version*": "allow",
      "tofu init*": "allow",

      // --- kubectl: read-only (apply/delete/edit/exec/cp/port-forward/config set -> ask) ---
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl explain*": "allow",
      "kubectl api-resources*": "allow",
      "kubectl api-versions*": "allow",
      "kubectl version*": "allow",
      "kubectl cluster-info": "allow",
      "kubectl top*": "allow",
      "kubectl diff*": "allow",
      "kubectl auth can-i*": "allow",
      "kubectl config get-contexts*": "allow",
      "kubectl config current-context*": "allow",
      "kubectl config view": "allow",

      // --- helm: read-only render/inspect (upgrade/delete/repo add/pull -> ask) ---
      "helm template*": "allow",
      "helm lint*": "allow",
      "helm show*": "allow",
      "helm list*": "allow",
      "helm status*": "allow",
      "helm history*": "allow",
      "helm get*": "allow",
      "helm version*": "allow",
      "helm env*": "allow",
      "helm dependency list*": "allow",

      // --- nix: eval/build only (run/shell/switch/profile/copy -> ask) ---
      "nix build*": "allow",
      "nix flake check*": "allow",
      "nix flake show*": "allow",
      "nix flake metadata*": "allow",
      "nix eval*": "allow",
      "nix fmt*": "allow",
      "nix search*": "allow",
      "nix derivation show*": "allow",
      "nix path-info*": "allow",
      "nix store ls*": "allow",
      "nix-build*": "allow",
      "nix-instantiate*": "allow",
      "nixos-rebuild build*": "allow",
      "nixos-rebuild dry-build*": "allow",
      "nixos-rebuild dry-activate*": "allow",
      "darwin-rebuild build*": "allow",
      "darwin-rebuild check*": "allow",
      "home-manager build*": "allow",

      // ===================== SECRET-FILE BLOCK (path-based) =====================
      // Reading these via bash would bypass the read-tool .env guard. Kept here
      // because it matches file paths, not subcommands. Remove if unwanted.
      "*.env*": "ask",
      "*id_rsa*": "ask",
      "*id_ed25519*": "ask",
      "*.pem*": "ask",
      "*credentials*": "ask"
    }
  }
}
